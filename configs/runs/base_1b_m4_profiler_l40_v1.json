{
  "version": "base_1b_m4_profiler_l40_v1",
  "purpose": "internal_kernel_and_communication_profile",
  "distributable": false,
  "model_spec": "configs/model/base_1b_gdn_v1.json",
  "data_dir": "/srv/small-agent/experiments/small-agent-p0-engineering-v1/data",
  "output_root": "/srv/small-agent/experiments/small-agent-base-1b-v1-engineering/runs",
  "seed": 20260924,
  "context_length": 4096,
  "micro_batch_size": 1,
  "gradient_accumulation_steps": 4,
  "max_steps": 10,
  "gradient_checkpointing": true,
  "optimizer": {
    "type": "adamw",
    "maximum_learning_rate": 0.0002,
    "minimum_learning_rate": 0.00002,
    "betas": [0.9, 0.95],
    "weight_decay": 0.1,
    "gradient_clip": 1.0
  },
  "scheduler": {
    "type": "warmup_cosine",
    "warmup_tokens": 400000,
    "total_tokens": 20000000
  },
  "logging_interval_steps": 1,
  "validation": {
    "at_start": false,
    "interval_steps": 1000,
    "batch_size": 1
  },
  "checkpoint": {
    "interval_steps": 0,
    "keep_full": 1
  },
  "profiler": {
    "enabled": true,
    "wait_steps": 3,
    "warmup_steps": 2,
    "active_steps": 3,
    "record_shapes": false,
    "profile_memory": true,
    "with_stack": false
  }
}
