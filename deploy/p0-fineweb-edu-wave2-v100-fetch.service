[Unit]
Description=P0 FineWeb-Edu wave2 direct pinned hf-mirror fetch on V100

[Service]
Type=simple
WorkingDirectory=/srv/small-agent/datasets/small-agent-p0/p0_500m_v1/fineweb_edu_wave2_v1/code
ExecStart=/usr/bin/python3 -u /srv/small-agent/datasets/small-agent-p0/p0_500m_v1/fineweb_edu_wave2_v1/code/p0_fetch_fineweb_edu_wave2_v100.py --root /srv/small-agent/datasets/small-agent-p0/p0_500m_v1/fineweb_edu_wave2_v1
Restart=on-failure
RestartSec=120
Nice=10
CPUQuota=200%
MemoryMax=4G
NoNewPrivileges=yes

[Install]
WantedBy=default.target
