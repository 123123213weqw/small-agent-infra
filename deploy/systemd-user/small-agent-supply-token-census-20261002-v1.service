[Unit]
Description=FineMath and new code candidate body token census (not training approval)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/small-agent/datasets/small-agent-p0/curation_v4/code
Environment=CUDA_VISIBLE_DEVICES=
Environment=RAYON_NUM_THREADS=4
Environment=TOKENIZERS_PARALLELISM=true
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Nice=15
CPUQuota=400%
MemoryMax=16G
TimeoutStartSec=infinity
ExecStart=/bin/bash -c '/srv/small-agent/venvs/deepspec_gemma4/bin/python -u scripts/p0_count_supply_candidates_v4.py --plan configs/curation/p0_supply_hfmirror_download_20261002_v1.json --config configs/curation/p0_supply_token_census_20261002_v1.json --legacy-receipt /srv/small-agent/datasets/small-agent-p0/curation_v4/legacy_inventory_20261002_v1/receipt.json --tokenizer /srv/small-agent/datasets/small-agent-p0/p0_1m_smoke_v1/tokenizer_v1/tokenizer.json --output /srv/small-agent/datasets/small-agent-p0/p0_500m_v1/upstream_supply_v4/candidate_token_census_v1 >> /srv/small-agent/artifacts/small-agent/curation_v4/logs/supply_token_census_20261002_v1.log 2>&1; rc=$?; echo "$rc" > /srv/small-agent/artifacts/small-agent/curation_v4/logs/supply_token_census_20261002_v1.exit; exit "$rc"'

[Install]
WantedBy=default.target
