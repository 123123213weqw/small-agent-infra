[Unit]
Description=Distributed CPU normalization across primary V100, external V100 and L40
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/srv/small-agent/datasets/small-agent-p0/curation_v4/code
ExecStart=/srv/small-agent/venvs/deepspec_gemma4/bin/python -u scripts/p0_distributed_scan_v12.py --config configs/curation/p0_distributed_scan_v12.json
Environment=CUDA_VISIBLE_DEVICES=
Environment=OMP_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=false
Nice=15
CPUQuota=600%
MemoryMax=16G
Restart=on-failure
RestartSec=60
TimeoutStopSec=30
KillMode=control-group
[Install]
WantedBy=default.target
