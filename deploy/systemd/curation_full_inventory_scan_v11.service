[Unit]
Description=Hash-register and normalize every existing V100 pretraining source v11
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/small-agent/datasets/small-agent-p0/curation_v4/code
ExecStartPre=/srv/small-agent/venvs/deepspec_gemma4/bin/python -u scripts/p0_full_inventory_register_v11.py --config configs/curation/p0_full_inventory_supply_v11.json
ExecStart=/srv/small-agent/venvs/deepspec_gemma4/bin/python -u scripts/p0_full_inventory_scan_v11.py --config configs/curation/p0_full_inventory_supply_v11.json
Environment=CUDA_VISIBLE_DEVICES=
Environment=OMP_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=false
CPUQuota=400%
MemoryMax=12G
Nice=15
TimeoutStartSec=0
[Install]
WantedBy=default.target
