[Unit]
Description=Verify READY training manifests and publish overnight curation delivery report
[Service]
Type=oneshot
WorkingDirectory=/srv/small-agent/datasets/small-agent-p0/curation_v4/code
ExecStart=/srv/small-agent/venvs/deepspec_gemma4/bin/python -u scripts/p0_production_delivery_v12.py --config configs/curation/p0_production_delivery_v12.json
