{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p0_source_registry_v1",
  "type": "object",
  "required": ["registry_version", "run_id", "sources"],
  "properties": {
    "registry_version": {"const": "p0_source_registry_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id", "dataset", "revision", "subset", "remote_file",
          "raw_relpath", "source_config", "license_status", "adapter_status",
          "advisory_bytes", "actual_bytes", "sha256"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "dataset": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "subset": {"type": ["string", "null"]},
          "remote_file": {"type": "string", "minLength": 1},
          "raw_relpath": {"type": "string", "minLength": 1},
          "source_config": {"type": "string", "minLength": 1},
          "license_status": {"enum": ["pending", "approved", "rejected"]},
          "adapter_status": {"enum": ["pending", "validated", "rejected"]},
          "advisory_bytes": {"type": "integer", "minimum": 1},
          "actual_bytes": {"type": ["integer", "null"], "minimum": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
