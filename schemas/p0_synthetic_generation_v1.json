{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p0_synthetic_generation_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["seed_id", "domain", "title", "text", "verification_cases"],
  "properties": {
    "seed_id": {"type": "string", "pattern": "^p0syn-[a-z0-9-]+-[0-9]{2}$"},
    "domain": {"type": "string", "enum": ["technical", "math_zh"]},
    "title": {"type": "string", "minLength": 4, "maxLength": 100},
    "text": {"type": "string", "minLength": 1200, "maxLength": 9000},
    "verification_cases": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expression", "expected"],
        "properties": {
          "expression": {"type": "string", "pattern": "^[0-9+*/() .\\-]{1,100}$"},
          "expected": {
            "oneOf": [
              {"type": "string", "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"},
              {"type": "integer", "minimum": -1000000000, "maximum": 1000000000}
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"domain": {"const": "math_zh"}}},
      "then": {"properties": {"verification_cases": {"minItems": 3}}}
    },
    {
      "if": {"properties": {"domain": {"const": "technical"}}},
      "then": {"properties": {"verification_cases": {"maxItems": 0}}}
    }
  ]
}
