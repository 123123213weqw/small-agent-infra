{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p0_teacher_quality_v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "decision",
    "confidence",
    "quality",
    "completeness",
    "educational_value",
    "format_integrity",
    "recommended_bucket",
    "reason_codes",
    "evidence"
  ],
  "properties": {
    "document_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"type": "string", "enum": ["keep", "drop"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "quality": {"type": "integer", "minimum": 1, "maximum": 5},
    "completeness": {"type": "integer", "minimum": 1, "maximum": 5},
    "educational_value": {"type": "integer", "minimum": 1, "maximum": 5},
    "format_integrity": {"type": "integer", "minimum": 1, "maximum": 5},
    "recommended_bucket": {
      "type": "string",
      "enum": [
        "general_zh",
        "general_en",
        "technical",
        "code_python",
        "code_shell",
        "code_other",
        "math_zh",
        "math_en",
        "drop"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "seo_or_ad",
          "template_or_noise",
          "stitched_content",
          "incomplete",
          "paywall_or_preview",
          "low_information",
          "wrong_bucket",
          "format_broken",
          "code_incomplete",
          "generated_or_vendored",
          "math_incomplete",
          "factual_or_logical_error",
          "sensitive_data",
          "uncertain"
        ]
      }
    },
    "evidence": {"type": "string", "minLength": 2, "maxLength": 240}
  }
}
