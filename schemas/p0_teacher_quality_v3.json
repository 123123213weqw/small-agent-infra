{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p0_teacher_quality_v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "body_sha256",
    "coverage",
    "decision",
    "confidence",
    "recommended_bucket",
    "anchors",
    "findings",
    "quality",
    "completeness",
    "educational_value",
    "format_integrity"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage": {
      "const": "full_document"
    },
    "decision": {
      "enum": [
        "keep",
        "drop",
        "uncertain"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recommended_bucket": {
      "enum": [
        "general_zh",
        "general_en",
        "technical",
        "code_python",
        "code_shell",
        "code_other",
        "math_zh",
        "math_en"
      ]
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 320
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "quotes",
          "explanation"
        ],
        "properties": {
          "code": {
            "enum": [
              "incomplete",
              "continuation_preview",
              "paywall",
              "seo_dominant",
              "template_dominant",
              "stitched_content",
              "format_broken",
              "factual_or_logical_error",
              "sensitive_data",
              "code_incomplete",
              "math_incomplete",
              "low_information",
              "uncertain",
              "registration_prompt",
              "ad_present",
              "external_figure"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "review",
              "reject"
            ]
          },
          "quotes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 8,
              "maxLength": 320
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 8,
            "maxLength": 360
          }
        }
      }
    },
    "quality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "completeness": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "educational_value": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "format_integrity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  }
}
